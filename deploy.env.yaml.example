# Copy to deploy.env.yaml and replace the deployment-specific values.
# Values are quoted because Cloud Run environment variables are strings.
GOOGLE_CLOUD_PROJECT: "your-monitoring-project"
METADATA_DATASET: "monitoring"
BQ_LOCATION: "EU"
STATE_BUCKET: "your-monitoring-project-monitor-state"
REPORT_TIMEZONE: "Europe/Warsaw"
MAXIMUM_BYTES_BILLED: "1073741824"
QUERY_TIMEOUT_SECONDS: "60"
LOG_ENTRY_LIMIT: "10000"
RUN_BUDGET_SECONDS: "1500"
NOTIFICATIONS_ENABLED: "false"
SMTP_HOST: "smtp.example.com"
SMTP_PORT: "587"
SMTP_USER: ""
SMTP_FROM: "monitor@example.com"
SMTP_SECURITY: "starttls"
# SMTP_PASS is injected from Secret Manager, never stored in this file.
